with daily as(
    select visited_on ,sum(amount) as amount
    from customer 
    group by visited_on
),

window_sum as(
    select visited_on,sum(amount)over(
        order by visited_on
        rows between 6 preceding and current row
            )as amount,
            count(*)over(
                order by visited_on 
                rows between 6 preceding and current row
            )as cnt
            from daily
)

select visited_on,amount,
round(amount/7,2)as average_amount
from window_sum
where cnt=7
order by visited_on;
